name: trace-lint
on:
  pull_request: { paths: ["04-docs/**", "12-governance/**"] }
  push: { paths: ["04-docs/**", "12-governance/**"] }
jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: { python-version: "3.12" }
      - run: python 10-scripts/02-trace_lint.py
