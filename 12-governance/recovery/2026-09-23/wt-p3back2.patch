+            "method": models.REFUND_METHOD_CHECK,
+            "reference": CHEQUE,
+            "reason": "Overpayment",
+            "requested_at": REQUESTED_AT.isoformat(),
+            "idempotency_key": str(uuid.uuid4()),
+        },
+        account_id=str(account.pk),
+    )
+    return account, answered
