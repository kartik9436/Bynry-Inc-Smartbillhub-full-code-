# ── SMARTBillHub — backend service environment ───────────────────────────────
#
# The root docker-compose.yml loads ONE file for the `backend` service:
# ./06-backend/.env — never this one (PO ruling 2026-08-10). THIS is the
# committed template you copy from, so what runs is exactly what is in `.env`
# and nothing is silently inherited from a checked-in file:
#   make env-init          # or: cp 06-backend/.env.example 06-backend/.env
# Then edit `.env`. It is gitignored and must never be committed.
# ⚠ Editing THIS file changes nothing on a host that already has a `.env` —
#   which is how the ALLOWED_HOSTS trap below survived to production.
# The frontend has its own file: 07-frontend/.env.example. The two images are
# independent; nothing here is read by the SPA.
#
# Every variable below is read by code in this repo. Verified by grepping
# `env(` / `env.bool` / `env.int` / `env.list` / `env.db` / `os.environ` across
# 06-backend — config/settings/base.py, config/settings/production.py,
# config/wsgi.py, manage.py, docker-entrypoint.sh. Nothing is aspirational.
#
# AWS values are noted per variable. There is no ALB and no nginx in this
# design: the browser reaches the frontend container, and the frontend
# container passes /api/* through to this one (07-frontend/server.mjs).


# ── Which settings module ────────────────────────────────────────────────────
# Read by config/wsgi.py (defaults to production — fails closed) and manage.py
# (defaults to LOCAL — which is why docker-entrypoint.sh refuses to start unless
# this is set explicitly: otherwise `migrate` and `gunicorn` would disagree).
# Keep this at production even locally. `local` means DEBUG=True and
# ALLOWED_HOSTS=["*"] — never what you want on a published port.
#   AWS: config.settings.production (identical)
DJANGO_SETTINGS_MODULE=config.settings.production


# ── Secret key ───────────────────────────────────────────────────────────────
# config/settings/base.py:10. The default in code is "dev-only-insecure"; this
# file makes the dev value explicit rather than silently inherited.
#   AWS: 64-byte URL-safe random, from the secret vault, distinct per
#        environment, rotation audited (🔒 — 09-infra/02 §6.1).
DJANGO_SECRET_KEY=dev-only-insecure


# ── Allowed hosts ────────────────────────────────────────────────────────────
# config/settings/production.py:22 — env.list, comma-separated. With DEBUG=False
# an EMPTY list rejects every request, so this is required.
#
# It must contain the Host the BROWSER sends, because 07-frontend/server.mjs
# forwards the Host header verbatim (that is what makes the origin the same
# origin). With the default compose port mapping the browser sends
# localhost:8080, and Django compares only the host part, so `localhost` is the
# entry that matters. 127.0.0.1 is here for the same reason under a different name.
#
# ⚠⚠ THIS LINE BROKE THE FIRST LIVE DEPLOYMENT (2026-08-10). The .env was copied
# from this template and never edited, so Django answered a bare **400 to every
# request** at smartbillhub.bynry.com — the browser sent that Host, this list did
# not contain it. Nothing in the boot log said so; gunicorn reported a clean,
# healthy start and then rejected everything. The entrypoint now WARNS at boot
# when production settings meet a localhost-only list, but the value itself is
# still yours to set:
#
#   AWS / any real domain:  DJANGO_ALLOWED_HOSTS=smartbillhub.bynry.com
#
# One host, NO leading dot — path tenancy means every tenant shares it
# (09-infra/02 §7.3). Add the ALB's health-check address beside it if the check
# reaches the task by private IP. Never a wildcard.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1


# ── Database — EXTERNAL Postgres, always ─────────────────────────────────────
# config/settings/base.py:182, env.db(). There is no database container in this
# stack; point this at your own Postgres 16.
#
# `host.docker.internal` is a Postgres running on the machine that runs Docker.
# The compose file adds an extra_hosts entry so that name also resolves on Linux,
# where it is not built in.
#
# ⚠ The `?sslmode=${DB_SSLMODE:-require}` suffix is deliberate and must stay.
# Docker Compose interpolates ${...} in env_file values, so the sslmode is a knob
# and there is nothing to edit in compose when it changes.
# Where DB_SSLMODE may be set, in decreasing precedence:
#   1. the shell:            DB_SSLMODE=disable docker compose up -d
#   2. the project-root .env file (compose reads it for interpolation)
#   3. this file — uncomment the line below
# (1) beats (3): with DB_SSLMODE set in the shell the URL takes the shell's
# value while the container still receives this file's DB_SSLMODE, which nothing
# reads.
#
# ⚠⚠ THE DEFAULT IS `require`, AND IT CHANGED ON 2026-08-10. It was `disable`,
# which is how it shipped and how it FAILED on the first real RDS deploy:
#
#     FATAL: no pg_hba.conf entry for host "…", user "…",
#            database "smartbillhub", no encryption
#
# That is RDS refusing an unencrypted connection (`rds.force_ssl=1` is on in the
# default PG15+ parameter group). The old default contradicted our own runbook,
# which has said `sslmode=require` for RDS since it was written (09-infra/02
# §6.1). And the loud failure is the GOOD case: against a Postgres that accepts
# unencrypted connections, `disable` sends the password and every row in clear
# text and nothing complains at all.
#
# So the default now fails closed. Plaintext is still available for a local
# Postgres with no TLS — but you have to ask for it by name:
#   DB_SSLMODE=disable make up
#
# `require` encrypts but does NOT verify the server certificate. Move to
# `verify-full` once the RDS CA bundle is on the task (09-infra/02 residual 16).
#DB_SSLMODE=require
DATABASE_URL=postgres://smartbillhub:smartbillhub@host.docker.internal:5432/smartbillhub?sslmode=${DB_SSLMODE:-require}

# ⚠ THE USERNAME IN THIS URL MUST NOT BE A SUPERUSER ON A REAL DEPLOYMENT (DEF-2717).
# PostgreSQL exempts superusers and BYPASSRLS roles from row-level security
# UNCONDITIONALLY — FORCE ROW LEVEL SECURITY included — so on such a role every
# tenant policy in the schema is skipped and ONE UTILITY CAN READ ANOTHER'S DATA.
# Nothing shows it: the tables still report relrowsecurity=t and
# relforcerowsecurity=t, the policies still exist, and every query returns
# plausible rows. Measured on PostgreSQL 16.13 with the B2 §3 policy in place and
# the same app.tenant_id on every connection: a NOSUPERUSER NOBYPASSRLS role read
# 2 rows, a SUPERUSER read 3 — the third being the OTHER tenant's.
#
# `smartbillhub` above is the DEVELOPMENT role and on many boxes it IS a superuser
# (apps/rating/migrations/0023 and tests/isolation_helpers.py both record finding
# it so). That is fine locally and config/settings/local.py tolerates it by name.
# A deployment must use a role created by 10-scripts/13-provision-database.sh,
# which types NOSUPERUSER NOBYPASSRLS, and `--verify` fails the run otherwise.
#
# The app checks this itself at every boot and REFUSES TO START under production
# settings on a bypassing role (06-backend/core/rls_guard.py).
#
# ⚠ LAW 4 — EDITING THIS TEMPLATE CHANGES NOTHING ON A HOST THAT ALREADY HAS A
# .env. Check an existing deployment by hand, once, and write the answer into
# 09-infra/02-aws-runbook.md §8.0's table (DEF-2760):
#   psql "$DATABASE_URL" -c "SELECT rolname, rolsuper, rolbypassrls FROM pg_roles WHERE rolname = current_user"



# ── Who is the client, behind our own proxy ──────────────────────────────────
# config/settings/base.py:78. How many proxies OF OURS sit in front of gunicorn.
# In this stack the answer is exactly one: the frontend container's static
# server, which appends the address it saw to X-Forwarded-For before passing
# /api/* through. With 1, apps.identity.auth.client_ip() and DRF's throttle
# identity both read the real caller; with 0 they would both see the frontend
# container's address for every request in the world — the BR-IDN-020 per-tenant
# IP allowlist and the public-onboarding throttle would collapse into one bucket.
# Add 1 per additional proxy of ours, never one for the client's own proxy.
#   AWS: still 1 — the frontend container is the only proxy in front of the API.
#        It becomes 2 the day something of ours is put in front of that.
#
# ⚠ **ON ECS (CR-144-BRC07) IT IS 1, AND FOR A DIFFERENT REASON THAN ABOVE.**
# There is no frontend container in front of the API any more — the SPA is
# static on S3 and the browser calls the API host directly — so the ONE proxy is
# the Application Load Balancer. It is still exactly one, so the value does not
# move; the chain it describes does. **Set it explicitly in all three task
# definitions.** Too low only over-restricts (allowlists tighten, throttles
# group); too high reads an `X-Forwarded-For` entry THE CLIENT WROTE, and a
# caller can then claim any allowlisted address it likes and mint an unlimited
# number of throttle identities.
TRUSTED_PROXY_COUNT=1


# ── Jobs ─────────────────────────────────────────────────────────────────────
# config/settings/base.py / production.py. Where a job BODY runs.
#
# ⚠ THIS BLOCK USED TO SAY "there is no Redis and no Celery worker in this
# stack" AND TOLD YOU TO SET IT true. As of the PO ruling of 2026-08-19 —
# *"We want Async job install redis and celery; Trigger after tenant creation;
# also add these two services in docker compose"* — both exist, and
# `docker-compose.yml` starts them.
#
#   false → the job is handed to Celery and a worker runs it. **This is the
#           value the compose stack wants**, because that stack now runs a
#           worker, and `true` there would run job bodies inside the web request
#           while the worker container idled and nothing said so.
#   true  → the job runs in-process at dispatch. Correct ONLY where no worker is
#           running: a laptop, a CI box, a one-off container.
#
# It is typed here rather than inherited, because the wrong one of these is
# silent in both directions (hard-won law 3). With a worker running and this
# true, provisioning takes ~40 s inside the signup request; with no worker and
# this false, every 202 rests `queued` FOREVER — which is what DEF-320 was, and
# it cost every new tenant its sample data and every bulk rate change its
# prices (DEF-326).
#   AWS: false, with a real broker reachable at CELERY_BROKER_URL and at least
#   one worker process running `celery -A config.celery worker`.
# ⚠ `DEF-MET-4954` — `false` moves every job body onto a worker, so the
# container that WRITES an export is never the one that SERVES it. That is why
# export files are stored in S3 (DOCUMENT_STORAGE_BUCKET below), never on a
# disk: until 2026-09-12 every Download here saved `file.json` containing a 404.
# Keep `false`, and set DOCUMENT_STORAGE_BUCKET / _REGION — exports need them.
JOBS_EAGER=false

# JOB_ARTIFACTS_DIR is GONE (2026-10-02). Export files are stored in this
# environment's S3 bucket under t/<web name>/export/ (PO: "Removed -> Yes we
# will just be using S3"). ⚠ Delete JOB_ARTIFACTS_DIR from an existing .env by
# hand; editing this template changes nothing on a host that already has one.


# ── Celery broker ────────────────────────────────────────────────────────────
# config/settings/base.py. WHERE THE TASK MESSAGES GO.
#
# ⚠ SET IT, AND DO NOT LEAVE IT COMMENTED. It was commented out until
# 2026-08-19 with the note *"uncomment on the day a worker exists"* — that day
# is today. The library default is `redis://localhost:6379/0`, and inside a
# container `localhost` is the container itself: nothing listens there, the
# worker retries forever, and the only symptom is jobs that never finish
# (09-infra/01 §4.1 says the same in its own words). The unsafe option must be
# the one you type, so this is the one you type.
#
# `redis` is the compose service name and resolves on the compose network.
#   AWS: rediss://… from the vault — TLS, and never a value committed here.
CELERY_BROKER_URL=redis://redis:6379/0

# ── The customer portal's own budget (NFR-38–41, PO ruling 2026-09-03) ────────
# ⚠ A template change never reaches a host that already has a `.env` (CLAUDE.md
# hard-won law 4): add these three lines to the deployed file by hand.
# CACHE_URL — where every rate limit counts. Without it Django counts in each
#   gunicorn worker's own memory, so "sixty a minute" is sixty PER WORKER and the
#   portal's in-flight budget cannot refuse anything. Same Redis as the broker,
#   a DIFFERENT database index, so a FLUSHDB on one cannot touch the other.
CACHE_URL=redis://redis:6379/1
# PORTAL_TENANT_RATE — one utility's visitors, in total, per minute (a default;
#   ten times the per-address sixty of BR-CWP-022).
PORTAL_TENANT_RATE=600/min
# PORTAL_INFLIGHT_MAX — portal requests served at once across the deployment.
#   Unset, it is GUNICORN_WORKERS − 1 so one worker is always free for a clerk.
# PORTAL_INFLIGHT_MAX=2

# ── HOW LONG ONE BACKGROUND JOB MAY RUN (CR-051 task 30) ─────────────────────
# Two limits and they do different jobs. The SOFT one raises inside the task,
# so the job records `failed` with a sentence and its checkpoint survives — the
# clerk presses the same button and the run carries on from where it stopped.
# The HARD one kills a worker that ignored the soft one; it records NOTHING, so
# it is the backstop that gets the worker slot back and not the honest failure.
#
# Both defaults are derived in config/settings/base.py from the largest run
# this deployment accepts (25,000 accounts) at the slowest per-account figure
# ever measured with row-level security enforced (0.219 s), plus half again:
# 5,475 s -> 8,220 s soft, and 300 s more for the failure row -> 8,520 s hard.
# Every other job kind fits inside that with room to spare.
#
# Lower them ONLY together and keep the gap: a soft limit above the hard one is
# never reached, and a gap too small kills the worker before the row is written.
# ⚠ EDITING THIS FILE FIXES NOTHING ALREADY DEPLOYED — a host that has a .env
# keeps what it has (hard-won law 4).
#CELERY_TASK_SOFT_TIME_LIMIT=8220
#CELERY_TASK_TIME_LIMIT=8520

# ── HOW BIG ONE BILL RUN OR PRINT SET MAY BE (CR-051 task 30, DEF-2806) ──────
# The other half of the same question. A run or a print set above the ceiling
# is refused AT THE DOOR, before anything is drafted or drawn, naming the count
# and the ceiling. `0` switches a ceiling off and has to be typed: the unsafe
# option is never the default (hard-won law 3).
#
# ⚠ Both names were quoted as deployment overrides by the code that reads them
# for a day before any settings module declared them, so setting either here
# did nothing at all (DEF-2806). They are declared now.
#BILLING_MAX_ACCOUNTS_PER_RUN=25000
#BILLING_MAX_BILLS_PER_PRINT_SET=25000


# ── gunicorn (read by docker-entrypoint.sh, not by Django) ───────────────────
# PORT is the port gunicorn binds INSIDE the container. The compose file does
# not publish it — the API is reached through the frontend container's /api
# pass-through — so changing it means changing API_PROXY_TARGET to match.
#PORT=8000
# 2n+1 for n vCPUs. 3 suits a 1-vCPU box.
#GUNICORN_WORKERS=3
# Seconds before a worker is killed. See the note in docker-entrypoint.sh: with
# eager jobs, a long export runs inside the request.
#GUNICORN_TIMEOUT=60


# ── App-layer field encryption (🔒 BR-CUS-092 / OQ-016) ──────────────────────
# config/settings/base.py. The keys core/crypto.py encrypts high-sensitivity
# columns with — `tenants.ein` today, the BR-CUS-092 government identifiers next.
#
#   FORMAT:  <kid>:<base64url 32 bytes>[,<kid>:<key>…]     FIRST ENTRY IS ACTIVE
#
# The first key encrypts every NEW value. Every other entry is decrypt-only, and
# that is the whole rotation procedure: put the new key FIRST, leave the old one
# behind it, deploy. Nothing has to be rewritten — each stored value carries the
# id of the key that made it, so old rows stay readable and stay matchable.
#
# GENERATE ONE (never reuse the example below, and never commit a real key):
#   python -c "import base64,os;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode().rstrip('='))"
#
# ⚠⚠ THERE IS NO DEFAULT AND NO FALLBACK. Unset, the code REFUSES: no plaintext,
# no invented key. config/settings/production.py will not even import, so the
# container does not start — and `migrate` would stop anyway, because the tenancy
# EIN backfill refuses to convert a row it cannot encrypt. This is the
# ALLOWED_HOSTS lesson applied deliberately: the unsafe option must be the one
# you type, and here it is not typeable at all.
#
# ⚠⚠ AND THIS LINE REACHES NO HOST THAT ALREADY HAS A `.env` (hard-won law 4 —
# exactly how the ALLOWED_HOSTS trap above survived to production). On EVERY
# already-provisioned deployment somebody must add this variable to that host's
# OWN `.env` BY HAND, before the next deploy. Nothing self-heals; the symptom is
# a container that will not boot, with the variable named in the message.
#
# ⚠ ROTATING IS ADDITIVE; REMOVING IS NOT. Dropping a key that still has rows
# written under it makes those rows permanently unreadable — the code raises and
# names the missing key id rather than returning anything. Retire a key only
# after a re-key pass, which nothing in the product does yet.
#   AWS: from the secret vault, distinct per environment, rotation audited
#        (🔒 — the same handling as DJANGO_SECRET_KEY, 09-infra/02 §6.1).
#   Generate one:  python -c "import base64,os;print('k1:'+base64.urlsafe_b64encode(
#                  os.urandom(32)).decode().rstrip('='))"
#   Format: <kid>:<base64url 32 bytes>[,<kid>:<key>…] — FIRST entry encrypts new
#   writes, the rest stay on the ring to decrypt older rows. The kid is lowercase
#   [a-z0-9_-] and is stored inside every ciphertext, so it may never contain ':'.
SBH_FIELD_ENCRYPTION_KEYS=

# ── The document store (CR-049) — WHERE A FROZEN LEGAL DOCUMENT'S BYTES GO ───
# Full design and every reason: apps/tenancy/document_storage.py.
#
# ⚠ NOT SETTING THESE IS SAFE AND VISIBLE, WHICH IS THE POINT. With no bucket,
# the product REFUSES to store a document, loudly, at the first attempt. It does
# NOT fall back to the container's local disk, where the next restart would
# destroy seven years of legal documents (NFR-35). That refusal is correct
# behaviour and is not a bug report.
#
# ⚠⚠ AND THESE LINES REACH NO HOST THAT ALREADY HAS A `.env` (hard-won law 4).
# Somebody must add them to that host's OWN `.env` by hand.
#
# ⚠⚠⚠ CR-160-BRC10 (PO 2026-10-02) — ONE BUCKET PER ENVIRONMENT, AND NO FILE IS
# OBJECT-LOCKED FOR NOW ("we dont want this to be enabled right now - dont lock
# it"), legal files included, and no file carries an expiry tag. Every file is
# stored at  t/<utility web name>/<module>/<yyyy>/<mm>/<file id>[.ext]  — e.g.
# t/austin-water/billing/2026/09/<file id>.pdf — and the key NEVER includes the
# bucket name. Files written before this change keep their old key
# t/<tenant id>/<yyyy>/<mm>/<file id> and still open; nothing was moved.
#
# So the bucket NO LONGER needs Object Lock at creation, and it MUST NOT carry a
# DEFAULT RETENTION rule: the boot check refuses one (smartbillhub.E002),
# because it would lock every file — every export included — for its whole
# period, and in COMPLIANCE mode nobody could delete one. Still worth setting:
# a lifecycle rule moving objects older than a year to cold storage, which is
# the difference between ~$27 and ~$8 a month for a hundred utilities' archive.
#
# ⚠ THIS PARAGRAPH REACHES NO HOST THAT ALREADY HAS A `.env` (hard-won law 4).
# A host whose .env types DOCUMENT_STORAGE_OBJECT_LOCK_MODE=COMPLIANCE keeps
# locking every new file until somebody edits THAT host's .env.
#
# CREDENTIALS. `boto3` resolves them the normal way and this repo defines no
# setting of its own for them — so the key names below are AWS's, not ours, and
# they are the ONLY spelling that works. PO 2026-09-03 chose the access-key pair
# over an instance role, so that the deployment is not tied to one EC2 instance:
#
#   AWS_ACCESS_KEY_ID=AKIA…            the IAM user's key
#   AWS_SECRET_ACCESS_KEY=…            its secret. THIS IS THE ONE SECRET HERE.
#
# Leave both UNSET to use an instance or task role instead — boto3 falls back to
# it on its own, and that is the better answer once the deployment stops moving.
# AWS_DEFAULT_REGION is NOT needed: the region is passed explicitly from
# DOCUMENT_STORAGE_REGION below.
# ── NO VIRUS SCANNER — REMOVED BY THE PO, 2026-09-22 AND 2026-09-23 ─────────
#
# From 2026-09-13 this block configured a scanner daemon that every upload was
# streamed through (BR-SHL-253). The PO removed the scan (DEF-SHL-6347), so
# there is no scanner setting to set and no scanner container to run.
#
# ⚠ **A HOST THAT ALREADY HAS A `.env` KEEPS ITS OLD SCANNER LINES** (hard-won
# law 4 — editing this file reaches no deployed host). They are read by nothing
# now; delete them by hand when convenient, or leave them, which is harmless.

#DOCUMENT_STORAGE_BACKEND=aws_s3
#DOCUMENT_STORAGE_BUCKET=
#DOCUMENT_STORAGE_REGION=
# Empty for AWS S3 itself; set for a VPC endpoint or an S3-compatible service.
#DOCUMENT_STORAGE_ENDPOINT_URL=
# Server-side encryption. Emptying it is REFUSED, not obeyed.
#DOCUMENT_STORAGE_SSE=AES256
# NFR-35's seven years.
#DOCUMENT_STORAGE_RETENTION_YEARS=7
# HOW THE DOCUMENT IS LOCKED. Leave it unset: NONE is the default from
# 2026-10-02 (CR-160-BRC10, PO: "dont lock it"). Typing COMPLIANCE or GOVERNANCE
# switches the lock on for files written AFTER that moment only, and needs a
# bucket created with Object Lock.
#   COMPLIANCE  nothing deletes a document before its retention ends — not an
#               administrator, not the account root. NFR-35. (Default until
#               2026-10-02.)
#   GOVERNANCE  same lock, deletable by a principal holding
#               s3:BypassGovernanceRetention.
#   NONE        (the default) no lock at all. THE ONLY VALUE THAT WORKS ON A
#               BUCKET CREATED WITHOUT OBJECT LOCK, where the other two are
#               refused with "Bucket is missing ObjectLockConfiguration".
#               Nothing written under it is protected from deletion by
#               anything except an IAM policy.
# PO 2026-09-03: "Until we are in beta mode We should able to delete these pdfs".
#DOCUMENT_STORAGE_OBJECT_LOCK_MODE=NONE
# FOUR HOURS (PO ruling 2026-08-30). Capped at four hours in code: this may
# SHORTEN a link's life without a deploy and cannot lengthen it. A link is a
# bearer token for one document — whoever holds it can open that document, and
# no other, until it expires.
#DOCUMENT_STORAGE_URL_TTL_SECONDS=14400
# DEF-TEN-9190 (2.460.1) — how long ONE S3 call may wait, and how many retries.
# The defaults are right; they exist so a host can change them without a deploy.
# ⚠ Every one of web, celery, celery-billing and celery-beat reads this file, and
# the WORKERS are what upload exports: give them the bucket, region and
# credentials too. A worker with no bucket now refuses to start.
#DOCUMENT_STORAGE_CONNECT_TIMEOUT=5
#DOCUMENT_STORAGE_READ_TIMEOUT=60
#DOCUMENT_STORAGE_MAX_ATTEMPTS=3
# An export job with no progress for this long is failed by celery-beat.
#EXPORT_STALL_SECONDS=1800

# ── Demo seed — NOT read by the server ───────────────────────────────────────
# apps/tenancy/management/commands/seed_demo.py reads this via os.environ, and
# that command refuses to run under config.settings.production by design. Listed
# so its absence here is a decision and not an oversight. To seed a non-production
# environment: docker compose exec backend python manage.py seed_demo
#SEED_DEMO_OWNER_PASSWORD=


# ═════════════════════════════════════════════════════════════════════════════
# CR-144-BRC07 (2026-09-28) — ECS Fargate behind an Application Load Balancer
#
# ⚠ ⚠ **EDITING THIS FILE CHANGES NOTHING ON A HOST THAT ALREADY HAS A `.env`,
# AND NOTHING ON AN ECS TASK AT ALL** (CLAUDE.md hard-won law 4). A deployed
# host keeps its own `06-backend/.env` until a human edits that file; an ECS
# task reads neither — its values are the task definition's `environment` and
# `secrets` blocks, and changing them needs a NEW TASK DEFINITION REVISION and
# a service update. Nothing below reaches anything by being written here.
# The per-environment values are in 09-infra/02-aws-runbook.md §X4.
# ═════════════════════════════════════════════════════════════════════════════

# ── CORS — the ONE origin the browser loads the app from ─────────────────────
# config/settings/base.py. The SPA is served from a DIFFERENT HOST to this API
# (decision log 2026-09-28 ruling 1 — two hosts, because the PO refused CDN
# path-routing of /api/* and the lock-in that comes with it), so every call the
# browser makes is cross-origin and needs an explicit grant.
#
# ⚠ EXACTLY ONE ORIGIN PER ENVIRONMENT AND NEVER `*`. Not taste:
# `Access-Control-Allow-Origin: *` and `Access-Control-Allow-Credentials: true`
# are mutually exclusive by specification, and the session cookie IS the
# credential — a wildcard would simply not work and would present as "signed in,
# and every call is 401". Empty default, so a deployment that forgets it grants
# nothing loudly rather than everything quietly.
#   Scheme and host, no trailing slash, no path.
#   AWS: dev       https://app-dev.bynry.com
#        sandbox   https://app-sand.bynry.com
#        production https://app.bynry.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── The Origin guard — the thing CORS does NOT do ────────────────────────────
# core/origin_guard.py. Defaults to CORS_ALLOWED_ORIGINS and is separate only so
# a difference can be expressed if one is ever needed; leave it unset.
#
# ⚠ WHY IT EXISTS: `app-*.bynry.com` and `api-*.bynry.com` are THE SAME SITE, so
# a SameSite=Lax session cookie rides along from ANY *.bynry.com page; DRF's
# default parsers accept form posts; and the session authenticator has no CSRF
# check. CORS does not stop a cross-origin form POST — the browser SENDS it and
# only hides the response, after the write has happened. So the refusal is
# server-side, in middleware, before any view runs.
#   AWS: unset (it follows CORS_ALLOWED_ORIGINS)
#ORIGIN_GUARD_ALLOWED_ORIGINS=

# ── The app's PUBLIC address — what a customer types, scans or clicks ────────
# config/settings/base.py · core/public_origin.py · DEF-CWP-9717, PO ruling
# 2026-10-05: "a setting per environment: each host names its public address".
# The customer portal's address, its Copy/Open buttons and its QR code are this
# plus /{utility}/portal — never the API's own host. Bare origin: scheme and
# host, no trailing slash, no path. Empty = no address shown and no QR code
# drawn (fails closed). ⚠ An existing host's .env does NOT get this from here.
# CR-188-BRC10: the staff invitation / reset emails' one-time sign-in link is
# this plus /{utility}/set-password?token=… — empty = those emails are not sent.
#   AWS: dev        https://app-dev.bynry.com
#        sandbox    https://app-sand.bynry.com
#        production https://app.bynry.com
PUBLIC_APP_ORIGIN=http://localhost:5173

# ── Text messages: ONE shared platform Twilio account (CR-198-BRC10) ─────────
# config/settings/base.py explains each. SERVER SECRETS — never in a tenant row,
# never on a screen. All empty ⇒ SMS fails closed (texts rest queued, named).
# ⚠ LAW 4: a host that already has a .env does NOT get these from this file —
# add them by hand on sandbox AND production. The PO supplies the values.
PUBLIC_API_BASE_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=
TWILIO_SENDER_BY_UTILITY=

# ── `Secure` on the sign-in cookies ──────────────────────────────────────────
# config/settings/base.py, read at the three places a session cookie is set
# (apps/identity/api.py, apps/tenancy/api.py, apps/portal/api.py).
#
# ⚠ THE CODE DEFAULT IS `true` (hard-won law 3 — the unsafe option is the one
# you type). This line types the unsafe one, because the local stack serves
# plain HTTP on localhost and a `Secure` cookie is accepted by the browser and
# then never sent back — sign-in appears to succeed and the next request is
# anonymous, with no error anywhere in the sequence.
#
# ⚠ AND LAW 4 BITES HERE SPECIFICALLY: a host that already has a `.env` has no
# such line, so it takes the code default `true`. That is RIGHT for every
# deployed environment and WRONG for a local `make up` over http://localhost —
# add this line to that host's own .env by hand.
#   AWS: true (or simply absent — the default is true)
SBH_AUTH_COOKIE_SECURE=false

# ── HTTPS, HSTS and the proxy's scheme header ────────────────────────────────
# config/settings/production.py. All optional; the defaults are the safe ones.
#
# SECURE_SSL_REDIRECT — default false, deliberately: the ALB's own HTTP listener
#   already redirects to HTTPS one hop earlier and cannot loop. Turn it on here
#   only with SECURE_PROXY_SSL_HEADER working, or every request redirects for
#   ever (the task never sees an https request, so the redirect never satisfies
#   itself). SECURE_PROXY_SSL_HEADER is set unconditionally in production.py and
#   is only safe because nothing but the ALB can reach port 8000 — that security
#   group rule is part of the setting, not separate from it.
#   ⚠ The health probe is unaffected either way: core.health answers ahead of
#     SecurityMiddleware, and tests/test_health.py holds that shut.
#   AWS: unset (false) unless the listener is not doing it
#SECURE_SSL_REDIRECT=false
#
# SECURE_HSTS_SECONDS — default 0 = NOT SENT. ⚠ HSTS IS THE ONE HEADER YOU
#   CANNOT TAKE BACK: a browser that has seen it refuses plain HTTP to this host
#   for the whole max-age whatever the server later says. Ramp it — 300 for a
#   day, 86400 for a week, then 31536000. Only ever sent on an https request, so
#   SECURE_PROXY_SSL_HEADER has to be right first or it is silently never sent.
#   AWS: 0 at first cutover; raise after one certificate renewal is observed
#SECURE_HSTS_SECONDS=0
#SECURE_HSTS_INCLUDE_SUBDOMAINS=false
#SECURE_HSTS_PRELOAD=false

# ── Redis on ElastiCache (CR-144-BRC07, X5 — NO CODE CHANGE, env only) ───────
# The two variables already above — CELERY_BROKER_URL and CACHE_URL — keep their
# names and their meanings. Only the values move.
#
# ⚠ **CLUSTER MODE MUST BE OFF, AND "ELASTICACHE SERVERLESS" IS CLUSTER MODE.**
# Serverless has no cluster-mode-disabled option; it is Redis Cluster with a
# configuration endpoint. Two things in this stack cannot use it:
#   * **DATABASE INDEXES.** Redis Cluster supports database 0 ONLY, and the
#     whole point of the two URLs is that the broker is db 0 and the cache is
#     db 1 — a `FLUSHDB` on one must not touch the other. `/1` on a cluster
#     endpoint is refused outright.
#   * **MULTI-KEY OPERATIONS ACROSS SLOTS.** Celery's and Django's Redis clients
#     are not cluster clients; they issue commands a cluster refuses unless the
#     keys hash to one slot.
# So: **a cluster-mode-DISABLED replication group**, one primary + one replica,
# with the PRIMARY endpoint in both URLs. The failure is not subtle but it is
# late — everything connects, and the first `SELECT 1` or multi-key command
# fails at runtime rather than at deploy.
#
# ⚠ **TLS IS `rediss://` WITH `?ssl_cert_reqs=required`.** Without the query
# parameter the client connects over TLS and VERIFIES NOTHING — which is
# hard-won law 7's "a check that cannot fail" wearing a lock icon. With
# encryption-in-transit on and a plain `redis://` URL, the connection is simply
# refused; that one at least fails loudly.
#
#   AWS: CELERY_BROKER_URL=rediss://<auth>@<primary-endpoint>:6379/0?ssl_cert_reqs=required
#        CACHE_URL=rediss://<auth>@<primary-endpoint>:6379/1?ssl_cert_reqs=required
#   Both from the secret vault — an AUTH token is a credential and is never
#   committed here or put in a task definition's `environment` block.

# ── 2.389.0 · THE NIGHTLY SESSION CLEANUP, AND WHY THERE IS NO SETTING HERE ───
# `CR-145-BRC08` (`B10`). `apps/identity/session_cleanup.py`.
#
# ⚠ **THERE IS DELIBERATELY NO VARIABLE IN THIS SECTION.** It is written here
# anyway, because the thing a deployer needs to know is not a value to set — it
# is that a new scheduled job exists, that it is the FIRST ONE IN THIS PRODUCT
# THAT DELETES ROWS, and that it will not run at all unless celery beat is
# actually deployed.
#
#   entry     `identity.session_cleanup`  (beat)
#   task      `smartbillhub.identity.session_cleanup`
#   when      03:20 every day — a clock time, not a duration, so it stays in the
#             quiet hours; and :20 rather than :00 because a job that fights
#             every other schedule for the same minute is a job that runs late.
#   deletes   sessions that have ALREADY EXPIRED or been SIGNED OUT
#   does NOT  touch an idle session. Idle is not expired. Nobody is signed out
#             by this job who was not already signed out.
#
# ⚠ **IT IS INSTALLED FROM `AppConfig.ready()`, NOT FROM `config/`.** Grepping
# `06-backend/config/` for a `beat_schedule` finds nothing and always will —
# that is the shape that kept the deployment runbook saying "beat has no
# schedule" for a month while six were running (`DEF-INF-7540`). **`G132` counts
# the entries from the code; run it rather than reading any list, including
# this one.**
#
# ⚠ **NO BEAT PROCESS, NO CLEANUP — AND NOTHING ERRORS.** `install()` never
# raises; a deployment without celery logs `installed: False` and starts
# normally. So the failure mode is silence: sessions accumulate for ever and no
# alarm anywhere fires. `09-infra/02-aws-runbook.md` §9.2 asks for liveness
# alarming on the beat singleton, and that is what covers this.
#
# ⚠ **AND THE LAW-4 WARNING APPLIES TO THIS WHOLE FILE, NOT JUST TO THIS BLOCK:
# EDITING `.env.example` CHANGES NOTHING THAT IS ALREADY DEPLOYED.** A host that
# already has its own `.env` never sees a line added here — this file is a
# TEMPLATE you copy, never a file any service loads. Nothing in this section
# needs copying, because it declares no variable; but the next block that does
# will need adding BY HAND to every existing host's own `.env`, and saying so
# every time is the rule rather than a courtesy.

# ── 2.389.0 · RELEASE NOTE — NOBODY IS SIGNED OUT BY THIS DEPLOY ──────────────
# **Sessions opened before the deploy keep their old cookie until they expire;
# nobody is forced to sign out.**
#
# ⚠ **THAT SENTENCE WAS CHECKED IN THE CODE BEFORE IT WAS PUBLISHED**, because
# it is a promise to every signed-in user. Four things had to be true and all
# four were verified against `22ef3fc7e`, and re-verified on 2026-09-28 against
# `c3e518b93`, after `identity/0008` landed:
#   1. the cookie NAMES are unchanged (`sbh_session` for staff, `sbh_portal`
#      for the customer portal) — renaming a live session cookie signs every
#      signed-in user out at once;
#   2. its VALUE is unchanged (the session id) — only `max_age` was added;
#   3. no migration deletes or revokes a session — `identity/0006`, `0007` and
#      `0008` touch `security_policies` (and write `audit_log`) and nothing else;
#   4. the nightly sweep removes only sessions already expired or signed out.
#
# ⚠ **ONE QUALIFICATION, AND IT IS PUBLISHED WITH THE SENTENCE RATHER THAN
# INSTEAD OF IT.** A utility that was on a four- or eight-hour inactivity
# timeout is migrated to one hour, so its staff are signed out AFTER A SHORTER
# IDLE PERIOD than before — up to seven hours shorter. Their cookie is untouched
# and their session is not revoked, so the sentence above stays literally true,
# and a clerk who steps away for ninety minutes is still signed out where
# yesterday they were not. **Both halves go out together: a promise that is true
# in a way the reader did not mean is worse than no promise.**
#
# ⚠ **AND THE FIX DOES NOT REACH ANYONE UNTIL THEY SIGN IN AGAIN.** "Keep me
# signed in" was broken because the cookie carried no expiry; a browser already
# holding one of those cookies goes on holding it. The repair arrives with the
# next sign-in, not with the deploy.


# ── CR-169-BRC10 · PostHog product analytics (server side) ───────────────────
# EMPTY = OFF, and that is the right value for local and compose. A deployed
# environment sets all four from its own pipeline settings: the key of THAT
# environment's PostHog project (never another's), its name, and the
# fingerprint of the production key so a dev/sandbox server handed the
# production key refuses to send. Changing them needs a restart (law 4).
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_ENVIRONMENT=
POSTHOG_PROD_KEY_FINGERPRINT=

# CR-187-BRC10 (DEF-FLD-10355) — the native field app's minimum product version.
# A build below it is refused 426 `app_too_old` on the field routes and shows
# "Update the app"; its captured work still syncs. 0.0.0 refuses nothing.
# Platform-wide, never per tenant. See core/field_app_version.py.
FIELD_APP_MIN_VERSION=0.0.0
