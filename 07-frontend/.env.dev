# ── SMARTBillHub frontend — DEV BUILD ────────────────────────────────────────
# `npm run build:dev` (vite --mode dev) reads this file.
#
# ⚠ NOTHING HERE IS A SECRET. Every VITE_* value is INLINED INTO THE BUNDLE by
# Vite and is therefore public the moment the bundle is on S3. That is why this
# file is committed: it is deployment configuration a reader must be able to
# check, not a credential store. Never put a key, a token or a password in it.
#
# ⚠ AND EVERY VALUE IS BAKED IN AT BUILD TIME (hard-won law 4 for the front
# end). Editing this file changes nothing already on S3 — it needs a rebuild
# and a fresh upload.
#
# ⚠ THIS FILE IS NOT `.env.example`. That one holds server.mjs's RUNTIME values
# (PORT, API_PROXY_TARGET) for local docker compose, which does not read this.

# ── Where the browser sends every API call ───────────────────────────────────
# A full ORIGIN, no trailing slash and no path: `src/api/client.ts` appends its
# own `/api` prefix. The frontend is served from https://app-dev.bynry.com and
# the API answers on a SEPARATE host (PO 2026-09-28 — no CDN path-routing, so
# moving off this cloud is not a blocker).
#
# Leave it EMPTY only for a same-origin build, which is the local dev server
# with server.mjs proxying /api. The build REFUSES an empty value for dev,
# sandbox and production — a silent relative fallback produces a bundle that
# calls its own static host and every screen fails at once (law 3).
VITE_API_BASE_URL=https://api-smart360-dev.bynry.com

# ── Which environment this bundle is ─────────────────────────────────────────
# `dev` | `sandbox` | `production`. Read for display and diagnostics only; it
# decides no behaviour, because a bundle that behaves differently by name is a
# bundle nobody can test.
VITE_APP_ENV=dev

# ── The screen-id tag: OFF, RULED FOR ALL THREE ──────────────────────────────
# PO 2026-09-28, verbatim: *"NO tags for no env to be put on screens as of now"*
# — which supersedes the same day's narrower *"No env tags on the screen"*. So
# the tag is off in dev, sandbox AND production; this variable no longer differs
# between the three files.
#
# ⚠ THE CAPABILITY STAYS. *"As of now"* is part of the ruling, so the variable,
# its type in `src/vite-env.d.ts` and `ScreenIdTag`/`PortalScreenIdTag` are all
# kept. A deleted capability is not a flag that is off: turning it back on for
# one environment must stay one word on this line, not a code change.
#
# ⚠ IT IS A **SCREEN** ID (`S49`, `CWP-052`), NOT AN ENVIRONMENT BANNER. This
# product has never drawn a banner reading DEV or SANDBOX, so the word *env* in
# the ruling implies no work — there is nothing of that kind to remove.
#
# `off` in any case removes it; anything else, including absent, leaves it on.
VITE_SCREEN_ID_TAG=off

# ── CR-169-BRC10 · PostHog user-activity tracking ────────────────────────────
# THE KEY IS NOT HERE AND MUST NEVER BE: `VITE_POSTHOG_KEY` (this environment's
# own PostHog project) and `VITE_POSTHOG_PROD_KEY_FINGERPRINT` (first 16 hex of
# sha256 of the PRODUCTION key) come from the pipeline's per-environment
# settings. With no key the bundle sends nothing. The build REFUSES a key that
# belongs to another environment (scripts/deployConfig.mjs).
VITE_POSTHOG_HOST=https://us.i.posthog.com
# The web host this bundle may send from; on any other host it sends nothing.
# From the README's table of builds — confirm with the pipeline before the
# first deploy that carries a key.
VITE_POSTHOG_EXPECTED_HOSTS=app-dev.bynry.com
