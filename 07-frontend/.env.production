# ── SMARTBillHub frontend — PRODUCTION BUILD ─────────────────────────────────
# `npm run build:prod` (vite --mode production) reads this file.
#
# ⚠ NOTHING HERE IS A SECRET — every VITE_* value is inlined into the bundle and
# is public once it is on S3. Never put a key, a token or a password in it.
# ⚠ EVERY VALUE IS BAKED IN AT BUILD TIME: editing this file changes nothing
# already on S3 (hard-won law 4). Rebuild and re-upload.
# ⚠ NOT `.env.example`, which holds server.mjs's RUNTIME values.

# A full ORIGIN, no trailing slash, no path — client.ts appends `/api`.
VITE_API_BASE_URL=https://api-smart360.bynry.com

VITE_APP_ENV=production

# ── The screen-id tag: OFF, RULED FOR ALL THREE ──────────────────────────────
# PO 2026-09-28, verbatim: *"NO tags for no env to be put on screens as of now"*
# — which supersedes the same day's narrower *"No env tags on the screen"*. So
# the tag is off in dev, sandbox AND production; this variable no longer differs
# between the three files.
#
# ⚠ THE CAPABILITY STAYS. *"As of now"* is part of the ruling, so the variable,
# its type in `src/vite-env.d.ts` and `ScreenIdTag`/`PortalScreenIdTag` are all
# kept. A deleted capability is not a flag that is off: turning it back on for
# one environment must stay one word on this line, not a code change.
#
# ⚠ IT IS A **SCREEN** ID (`S49`, `CWP-052`), NOT AN ENVIRONMENT BANNER. This
# product has never drawn a banner reading DEV or SANDBOX, so the word *env* in
# the ruling implies no work — there is nothing of that kind to remove.
#
# `off` in any case removes it; anything else, including absent, leaves it on.
VITE_SCREEN_ID_TAG=off

# ── CR-169-BRC10 · PostHog user-activity tracking ────────────────────────────
# THE KEY IS NOT HERE AND MUST NEVER BE: `VITE_POSTHOG_KEY` (this environment's
# own PostHog project) and `VITE_POSTHOG_PROD_KEY_FINGERPRINT` (first 16 hex of
# sha256 of the PRODUCTION key) come from the pipeline's per-environment
# settings. With no key the bundle sends nothing. The build REFUSES a key that
# belongs to another environment (scripts/deployConfig.mjs).
VITE_POSTHOG_HOST=https://us.i.posthog.com
# The web host this bundle may send from; on any other host it sends nothing.
# From the README's table of builds — confirm with the pipeline before the
# first deploy that carries a key.
VITE_POSTHOG_EXPECTED_HOSTS=app.bynry.com
