# ── SMARTBillHub — frontend service environment ──────────────────────────────
#
# The root docker-compose.yml loads THIS FILE for the `frontend` service, then
# loads ./07-frontend/.env on top of it if that file exists (later wins). Copy
# this file to 07-frontend/.env to change something locally; never commit that
# copy (.gitignore). The backend has its own file: 06-backend/.env.example.
#
# ⚠ NOTHING HERE IS A BUILD VARIABLE. Vite inlines only `VITE_*` variables at
# build time and src/vite-env.d.ts declares none — "THERE ARE NONE RIGHT NOW".
# The bundle is environment-independent: the same image is valid in every
# environment, and the two variables below are read at RUN time by server.mjs,
# never baked into the JavaScript. (`VITE_TENANT_HOST_SUFFIX` was deleted with
# the cross-host signup handoff; a tenant now lives at `/{tenant}` on whatever
# origin the browser is already on. Do not reintroduce it.)


# ── The port this container listens on ───────────────────────────────────────
# Inside the container. The compose file maps the host port onto it and is the
# only place the host-side number appears (WEB_PORT there).
PORT=8080


# ── Where /api/* goes ────────────────────────────────────────────────────────
# THIS IS THE ROUTING MECHANISM, not a development convenience.
#
# The SPA and the API are separate containers, but the app is built same-origin:
# src/api/client.ts calls `/api/{tenant}/…` against an empty base URL and the
# session cookie is httpOnly and host-scoped. Cross-origin breaks both at once.
# There is no ALB and no nginx in this deployment (PO, 2026-08-10), so
# server.mjs is what joins them: it serves the bundle AND passes /api/* through
# to the API container, unchanged — same method, same path, same body, same
# Cookie, and the API's own status code and Set-Cookie come back untouched.
#
# `backend` is the compose service name; 8000 is the port gunicorn binds inside
# that container (PORT in 06-backend/.env.example). Change this to move the API,
# not to turn the feature off.
#   AWS: whatever address the API answers on from this container — the ECS
#        service's private DNS name, or a host:port on the same box. It stays
#        SET; there is nothing else routing /api.
#
# ⚠ Setting it EMPTY does not "let something else handle /api" — it leaves this
# origin with no API. /api/* then answers 404 (and NEVER index.html: the API's
# 404 is how an unknown tenant and a foreign tenant are made indistinguishable,
# and turning that into a 200 would answer "here is the app" to both). Only set
# it empty if you have genuinely put another proxy in front of this container.
API_PROXY_TARGET=http://backend:8000


# ── Not variables, but the two other things server.mjs knows about ───────────
# STATIC_DIR — where the bundle is (defaults to ./dist next to server.mjs).
# Only the tests set it; there is no reason to in a container.
#HOST=0.0.0.0
#STATIC_DIR=/app/dist
