{
  "name": "smartbillhub-frontend",
  "private": true,
  "version": "2.614.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:types && npm run build:bundle",
    "build:types": "tsc --noEmit -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:bundle": "vite build --mode compose",
    "build:dev": "tsc --noEmit && vite build --mode dev",
    "build:sandbox": "tsc --noEmit && vite build --mode sandbox",
    "build:prod": "tsc --noEmit && vite build --mode production",
    "check:bundle": "node scripts/checkBundleHost.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "node --test server.test.mjs",
    "serve": "node server.mjs",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-table": "^8.20.0",
    "i18next": "^23.12.0",
    "leaflet": "^1.9.4",
    "posthog-js": "^1.435.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.0",
    "react-router-dom": "^6.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.5.4",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
